# Copy to deploy/.env for deploy/compose.local.yml. deploy/.env is gitignored.
# On Fly the same names are set with `fly secrets set` (deploy/README.md).

DJANGO_SECRET_KEY=local-only-change-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# The all-in-one image creates this database and user on first boot.
POSTGRES_DB=cycling_manager
POSTGRES_USER=cycling
POSTGRES_PASSWORD=local-only-change-me

# Optional. Each feature is off while its variable is empty.
SENTRY_DSN=
HEALTHCHECKS_TICK_URL=
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=backups
